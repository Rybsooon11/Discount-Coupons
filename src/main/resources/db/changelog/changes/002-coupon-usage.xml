<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="002-create-coupon-usage" author="coupons">
        <createTable tableName="coupon_usage">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="coupon_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_coupon_usage_coupon"
                             references="coupon(id)"/>
            </column>
            <column name="user_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="used_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="used_from_ip" type="VARCHAR(45)">
                <constraints nullable="false"/>
            </column>
            <column name="used_from_country" type="VARCHAR(2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="coupon_usage"
                             columnNames="coupon_id, user_id"
                             constraintName="uq_coupon_usage_coupon_user"/>

        <createIndex tableName="coupon_usage" indexName="idx_coupon_usage_coupon">
            <column name="coupon_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
